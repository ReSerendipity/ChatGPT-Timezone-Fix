{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "111",

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "__MSG_extName__"
  },

  "options_page": "options/options.html",

  "background": {
    "service_worker": "background/background.js"
  },

  "permissions": ["storage", "debugger", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/common.js", "src/content-main.js"]
    },
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "js": ["src/common.js", "src/i18n.js", "src/content-controller.js"]
    }
  ],

  "commands": {
    "random-timezone": {
      "suggested_key": { "default": "Ctrl+Shift+Z" },
      "description": "__MSG_cmdRandom__"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["_locales/*/messages.json", "data/timezones.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
